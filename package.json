{
  "name": "react-hook-extensions",
  "version": "1.0.0",
  "description": "Hooks we all wish were already built into React.",
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "typescript"
  ],
  "license": "MIT",
  "author": "Elie Bouzaglo",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.registry.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
